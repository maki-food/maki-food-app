{
  "name": "Order",
  "type": "object",
  "properties": {
    "created_by_id": {
      "type": "string"
    },
    "restaurant_name": {
      "type": "string"
    },
    "restaurant_cnpj": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Pedido Emitido",
        "Em Separação",
        "Com Entregador",
        "Saiu para Entrega",
        "Finalizado"
      ],
      "default": "Pedido Emitido"
    },
    "delivery_address": {
      "type": "string"
    },
    "payment_method": {
      "type": "string"
    },
    "contact_info": {
      "type": "string"
    },
    "observations": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "barcode": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "shipping_fee": {
      "type": "number",
      "default": 0
    },
    "deliverer_id": {
      "type": "string"
    },
    "deliverer_name": {
      "type": "string"
    },
    "delivery_photo_url": {
      "type": "string"
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "Pendente",
        "Aceito",
        "Saiu para Entrega",
        "Finalizado"
      ],
      "default": "Pendente"
    },
    "delivery_completed_at": {
      "type": "string"
    }
  },
  "required": [
    "restaurant_name",
    "delivery_address",
    "payment_method"
  ]
}
