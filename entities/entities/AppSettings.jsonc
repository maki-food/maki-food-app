{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "app_name": {
      "type": "string",
      "default": "Maki Food - Tudo Para Seu Restaurante"
    },
    "logo_url": {
      "type": "string"
    },
    "hero_image_url": {
      "type": "string"
    },
    "hero_image_mobile_url": {
      "type": "string"
    },
    "banners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "desktop_banners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "mobile_banners": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "banner_interval": {
      "type": "number",
      "default": 5
    },
    "sidebar_bg": {
      "type": "string",
      "default": "#0f172a"
    },
    "primary_color": {
      "type": "string",
      "default": "#059669"
    },
    "page_bg": {
      "type": "string",
      "default": "#f8fafc"
    },
    "topbar_bg": {
      "type": "string",
      "default": "#ffffff"
    },
    "category_bar_bg": {
      "type": "string",
      "default": "#f8fafc"
    },
    "admin_text_color": {
      "type": "string",
      "default": "#ffffff"
    },
    "store_text_color": {
      "type": "string",
      "default": "#475569"
    },
    "cart_card_bg": { "type": "string", "default": "#059669" },
    "cart_card_text": { "type": "string", "default": "#ffffff" },
    "cart_button_bg": { "type": "string", "default": "#ffffff" },
    "cart_button_text": { "type": "string", "default": "#047857" },
    "invoice_logo_url": {
      "type": "string"
    },
    "invoice_header_text": {
      "type": "string"
    },
    "invoice_footer_text": {
      "type": "string"
    },
    "expiration_threshold_days": {
      "type": "number",
      "default": 7
    },
    "payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "Pix",
        "Dinheiro"
      ]
    },
    "shipping_fee": {
      "type": "number",
      "default": 20
    },
    "free_shipping_threshold": {
      "type": "number",
      "default": 200
    },
    "pickup_address": {
      "type": "string",
      "description": "Endereco para retirada no estabelecimento"
    }
  },
  "required": [
    "app_name"
  ]
}
